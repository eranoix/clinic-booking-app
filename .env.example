# Copy to .env at the repository root. `npm run app`, `npm run dev` in web/
# and `docker compose` all read it. Every variable is optional.

# Password for the front desk (/admin). Empty: no sign-in, which is only
# acceptable on your own machine. Set: /admin asks for it and keeps a signed,
# HttpOnly session cookie for 12 hours.
ADMIN_PASSWORD=

# Extra secret mixed into the session signature. Changing it (or the
# password) signs everyone out. Empty is fine for a demo.
SESSION_SECRET=

# Port the site listens on (npm run app) or is published on (docker compose).
PORT=3000

# Interface `npm run app` binds to. 127.0.0.1 keeps it on this machine;
# 0.0.0.0 exposes it to your network -- set ADMIN_PASSWORD first.
HOST=127.0.0.1

# Address used for the links inside outbox messages ("move or cancel here").
# Default: http://localhost:<PORT>.
PUBLIC_URL=

# Where the SQLite database lives. Default: web/data/clinic.db. In Docker it
# is /data/clinic.db, on the clinic-data volume.
CLINIC_DB=
